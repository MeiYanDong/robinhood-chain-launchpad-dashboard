[Unit]
Description=Robinhood Chain Launchpad dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robinhood-launchpad
Group=robinhood-launchpad
WorkingDirectory=/opt/robinhood-chain-launchpad/current
EnvironmentFile=/etc/robinhood-chain-launchpad.env
Environment=HOST=127.0.0.1
Environment=PORT=4175
Environment=DATA_DIR=/var/lib/robinhood-chain-launchpad
Environment=CACHE_TTL_MINUTES=1500
Environment=PAIR_ACTIVE_MCAP_FLOOR_USD=10000
Environment=PAIR_ACTIVE_DEPTH_FLOOR_USD=1000
Environment=PAIR_MARKET_FRESHNESS_MINUTES=60
Environment=PAIR_REFRESH_TTL_MINUTES=15
Environment=PAIR_HOLDER_TTL_MINUTES=60
Environment=PAIR_HOLDER_MAX_STALE_MINUTES=150
Environment=PAIR_GMGN_BIN=/opt/robinhood-chain-launchpad/current/node_modules/.bin/gmgn-cli
Environment=PAIR_FLOW_REFRESH_TTL_MINUTES=5
Environment=PAIR_FLOW_STALE_AFTER_MINUTES=20
Environment=PAIR_V2_GMGN_BIN=/opt/robinhood-chain-launchpad/current/node_modules/.bin/gmgn-cli
Environment=PAIR_V2_CHAIN_POLL_SECONDS=8
Environment=PAIR_ALPHA_HOT_MARKET_POLL_SECONDS=15
Environment=PAIR_V2_MARKET_POLL_SECONDS=60
Environment=PAIR_V2_STALE_AFTER_SECONDS=150
Environment=DEV_MONITOR_ENABLED=true
Environment=DEV_MONITOR_POLL_SECONDS=11
Environment=DEV_MONITOR_MARKET_POLL_SECONDS=300
Environment=DEV_MONITOR_CONFIRMATIONS=2
Environment=DEV_MONITOR_BOOTSTRAP_BLOCKS=250000
Environment=DEV_MONITOR_BUY_CATCHUP_BLOCKS_PER_POLL=2000
Environment=DEV_MONITOR_BUY_MAX_RECOVERABLE_LAG_BLOCKS=10000
Environment=DEV_MONITOR_RPC_MIN_INTERVAL_MS=750
Environment=DEV_MONITOR_ALERT_MAX_AGE_MINUTES=45
Environment=DEV_MONITOR_ALERT_HOURLY_LIMIT=3
Environment=DEV_MONITOR_ALERT_BATCH_SIZE=3
Environment=DEV_MONITOR_ALERT_DEVELOPER_COOLDOWN_MINUTES=360
Environment=DEV_MONITOR_ALERT_DELIVERY_COOLDOWN_MINUTES=20
Environment=LONG_GMGN_BIN=/opt/robinhood-chain-launchpad/current/node_modules/.bin/gmgn-cli
Environment=ECONOMICS_GMGN_BIN=/opt/robinhood-chain-launchpad/current/node_modules/.bin/gmgn-cli
Environment=INTELLIGENCE_CHAIN_RADAR_URL=http://127.0.0.1:4173/api/latest
Environment=INTELLIGENCE_CASHCAT_STATUS_URL=http://127.0.0.1:8010/api/status
Environment=INTELLIGENCE_REFRESH_TTL_MINUTES=5
Environment=INTELLIGENCE_REQUEST_TIMEOUT_MS=8000
ExecStart=/usr/local/bin/node /opt/robinhood-chain-launchpad/current/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/robinhood-chain-launchpad
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
