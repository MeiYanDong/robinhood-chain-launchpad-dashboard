# Copy to /etc/cashcat-sentinel/production.env with mode 600.
# This monitor needs API keys only. Never add wallet private keys or seed phrases.
GMGN_API_KEY=replace-with-read-only-key
TWITTERAPI_IO_KEY=replace-with-read-only-key

CASHCAT_POLL_SECONDS=300
CASHCAT_REPORT_TIMEZONE=Asia/Shanghai
CASHCAT_REPORT_CUTOFF_HOUR=8
CASHCAT_REPORT_SCHEDULE_MINUTE=10
CASHCAT_REPORT_MINIMUM_COVERAGE=0.90
CASHCAT_REPORT_EXPORT_PNG=1
